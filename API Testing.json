    {
      "v": "6",
      "name": "05 Create a post",
      "method": "POST",
      "endpoint": "<<baseUrl>>/posts",
      "auth": {
        "authType": "none",
        "authActive": true
      },
      "params": [],
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json",
          "active": true
