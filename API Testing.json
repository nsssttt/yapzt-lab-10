      ],
      "body": {
        "body": "{\n  \"title\": \"New Post\",\n  \"body\": \"Content of new post\",\n  \"userId\": 1\n}",
        "contentType": "application/json"
      },
      "requestVariables": [],
      "preRequestScript": "pw.env.set(\"LastPostCreationTime\", String(Date.now()));",
      "testScript": "pw.test(\"HTTP 201\", () => { pw.expect(pw.response.status).toBe(201) });\npw.test(\"JSON object\", () => { const body = pw.response.body; pw.expect(body !== null && typeof body === \"object\" && !Array.isArray(body)).toBe(true) });\npw.test(\"Post title\", () => { pw.expect(pw.response.body.title).toBe(\"New Post\") });\nif (pw.response.status === 201) {\n  const previous = Number(pw.env.get(\"LastPostCreationTime\"));\n  const now = Date.now();\n  pw.test(\"Timestamp refreshed\", () => pw.expect(now >= previous && previous > 0).toBe(true));\n  pw.env.set(\"LastPostCreationTime\", String(now));\n  pw.env.set(\"newPostId\", String(pw.response.body.id));\n}"
    },
